#define CONFIG_WIRELESS
#define ZMK_BASE_LAYER(name, LT, RT, LM, RM, LB, RB, LH, RH)                   \
    ZMK_LAYER(                                                                 \
        name,                                                                  \
                &kp ESC      LT  RT &out OUT_TOG                                       \
                L_OUTER(MID, name) LM RM &none                                 \
                L_OUTER(BOT, name) LB RB &none                                 \
                L_OUTER(THB, name) LH RH &siri                                 \
    )

// Left outer column (middle, bottom) and outer-left thumb, per layer. Every
// layer uses the standard set except Num, which uses the number-pad set.
#define L_OUTER(POS, name) L_CAT(L_##POS##_, L_SET_##name)
#define L_CAT(a, b) L_CAT_(a, b)
#define L_CAT_(a, b) a##b

#define L_SET_Base  STD
#define L_SET_Nav   STD
#define L_SET_Fn    STD
#define L_SET_Num   NUMPAD
#define L_SET_Sys   STD
#define L_SET_Mouse STD

#define L_MID_STD    CMD_UNDO
#define L_BOT_STD    CMD_REDO
#define L_THB_STD    &kp GLOBE
#define L_MID_NUMPAD &kp BSPC
#define L_BOT_NUMPAD CMD_UNDO
#define L_THB_NUMPAD &kp TAB

#include "zmk-helpers/key-labels/42.h"
#include "base.keymap"

// Siri: holds Globe+S for as long as the key is held (tap = type to Siri,
// hold = talk to Siri), like Apple's mic key.
ZMK_MACRO(siri,
    bindings = <&macro_press &kp GLOBE &kp S>,
               <&macro_pause_for_release>,
               <&macro_release &kp S &kp GLOBE>;)

/{ chosen { zmk,physical-layout = &foostan_corne_6col_layout; }; };
